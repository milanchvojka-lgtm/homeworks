                            0
                          ],
                          "children": [
                            {
                              "type": "text",
                              "id": "TPKiT",
                              "name": "Otázka",
                              "fill": "$hw-ink",
                              "content": "How long does setup take?",
                              "fontFamily": "$hw-font-sans",
                              "fontSize": 20,
                              "fontWeight": "700"
                            },
                            {
                              "type": "text",
                              "id": "bRMBb",
                              "name": "Odpověď",
                              "fill": "$hw-ink-60",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "About 15–20 minutes: your kids, their areas, chores and a few paid jobs. Then you launch the app together with your kids. The first week is a trial run, and they get a starter bonus.",
                              "lineHeight": 1.55,
                              "fontFamily": "$hw-font-sans",
                              "fontSize": 17,
                              "fontWeight": "normal"
                            }
                          ]
                        },
                        {
                          "type": "frame",
                          "id": "t2WEbY",
                          "name": "Co o dětech ukládáte?",
                          "width": "fill_container",
                          "stroke": "$hw-rule",
                          "strokeWidth": {
                            "top": 1
                          },
                          "layout": "vertical",
                          "gap": 8,
