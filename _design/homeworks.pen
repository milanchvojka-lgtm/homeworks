                          "children": [
                            {
                              "type": "text",
                              "id": "g2Nvxi",
                              "name": "Otázka",
                              "fill": "$hw-ink",
                              "content": "How much does it cost?",
                              "fontFamily": "$hw-font-sans",
                              "fontSize": 20,
                              "fontWeight": "700"
                            },
                            {
                              "type": "text",
                              "id": "RTkDi",
                              "name": "Odpověď",
                              "fill": "$hw-ink-60",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "Nothing, for now. You pay with feedback: what works, what doesn’t, and what’s missing. If we ever introduce a fee, it will cover the cost of running the app plus 50%. With a few dozen families, that comes to a small amount each month.",
                              "lineHeight": 1.55,
                              "fontFamily": "$hw-font-sans",
                              "fontSize": 17,
                              "fontWeight": "normal"
                            }
                          ]
                        },
                        {
                          "type": "frame",
                          "id": "Ov5vo",
                          "name": "Na čem to běží?",
                          "width": "fill_container",
                          "stroke": "$hw-rule",
                          "strokeWidth": {
                            "top": 1
                          },
                          "layout": "vertical",
                          "gap": 8,
                          "padding": [
                            24,
                            0
                          ],
                          "children": [
                            {
                              "type": "text",
                              "id": "VKeWB",
                              "name": "Otázka",
                              "fill": "$hw-ink",
                              "content": "What does it run on?",
                              "fontFamily": "$hw-font-sans",
                              "fontSize": 20,
                              "fontWeight": "700"
                            },
                            {
                              "type": "text",
                              "id": "toRwG",
                              "name": "Odpověď",
                              "fill": "$hw-ink-60",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "Your phone. Open the link in your browser and add it to your home screen, and it works just like an app. Nothing to download from the App Store.",
                              "lineHeight": 1.55,
                              "fontFamily": "$hw-font-sans",
                              "fontSize": 17,
                              "fontWeight": "normal"
                            }
                          ]
                        },
                        {
                          "type": "frame",
                          "id": "cVbrh",
                          "name": "Jak dlouho trvá nastavení?",
                          "width": "fill_container",
                          "stroke": "$hw-rule",
                          "strokeWidth": {
                            "top": 1
                          },
                          "layout": "vertical",
                          "gap": 8,
                          "padding": [
