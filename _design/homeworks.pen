              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "3 týdny zkusíme jiný systém pro povinnosti a obrazovku.",
              "lineHeight": 1.2,
              "fontFamily": "Cormorant Garamond",
              "fontSize": 34,
              "fontWeight": "500",
