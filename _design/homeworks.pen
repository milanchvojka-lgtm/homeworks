                    },
                    {
                      "type": "text",
                      "id": "6fCxA",
                      "fill": "$--hink",
                      "content": "Kredit místo dohadování",
                      "fontFamily": "Cormorant Garamond",
                      "fontSize": 22,
                      "fontWeight": "500"
