                  "fill": "$--hmuted",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Tři oblasti — kuchyň, obývák, koupelna. Každý týden je má jedna z holek na starost. Každá projde každou jednou za 3 týdny.",
                  "lineHeight": 1.55,
                  "fontFamily": "Inter",
                  "fontSize": 15,
                  "fontWeight": "normal"
