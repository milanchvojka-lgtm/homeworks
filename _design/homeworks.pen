            {
              "type": "text",
              "id": "qwIfj",
              "fill": "$--hink",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Občas to dopadne hádkou. Často to končí tím, že to nakonec uděláme sami a holky o tom ani nevědí.",
              "lineHeight": 1.6,
              "fontFamily": "Inter",
              "fontSize": 16,
              "fontWeight": "normal"
            },
            {
              "type": "text",
