                          "children": [
                            {
                              "type": "text",
                              "id": "c3FCa",
                              "name": "Otázka",
                              "fill": "$hw-ink",
                              "content": "What do you store about my kids?",
                              "fontFamily": "$hw-font-sans",
                              "fontSize": 20,
                              "fontWeight": "700"
                            },
                            {
                              "type": "text",
                              "id": "j1OVeZ",
                              "name": "Odpověď",
                              "fill": "$hw-ink-60",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "Only the name you enter and what they do in the app: chores, jobs, balance. No email or phone number for your kids, and no ads.",
                              "lineHeight": 1.55,
                              "fontFamily": "$hw-font-sans",
                              "fontSize": 17,
                              "fontWeight": "normal"
                            }
                          ]
                        },
                        {
                          "type": "frame",
                          "id": "b8VsP",
                          "name": "Co když je dítě na táboře nebo nemocné?",
