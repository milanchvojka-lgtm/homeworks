                              "name": "Otázka",
                              "fill": "$hw-ink",
                              "content": "What if my kid is at camp or sick?",
                              "fontFamily": "$hw-font-sans",
                              "fontSize": 20,
                              "fontWeight": "700"
                            },
                            {
                              "type": "text",
                              "id": "CPMou",
                              "name": "Odpověď",
                              "fill": "$hw-ink-60",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "Mark them as away from–to, even after the fact within the current week. They don’t have to do anything on those days, and they keep their streak and bonus.",
                              "lineHeight": 1.55,
                              "fontFamily": "$hw-font-sans",
                              "fontSize": 17,
                              "fontWeight": "normal"
