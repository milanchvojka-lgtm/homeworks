              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Investice z mojí strany: 2–3 týdny stavby aplikace navíc po práci. Z tvojí strany: 30 minut dnes, 5 minut denně po dobu zkoušky, a upřímná zpětná vazba na konci.",
              "lineHeight": 1.6,
              "fontFamily": "Inter",
